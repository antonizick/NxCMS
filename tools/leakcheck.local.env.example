# leakcheck.local.env — your origin install's real identity, for leakcheck.sh
# to scan for. Copy this to tools/leakcheck.local.env (gitignored, never
# committed/published) and fill in your own values. Leave any line unset/blank
# to skip that check.

LEAKCHECK_ORIGIN_USER=""       # shell username on your live server
LEAKCHECK_ORIGIN_SERVER=""     # hosting provider's server identifier
LEAKCHECK_ORIGIN_DB=""         # live database name
LEAKCHECK_ORIGIN_HOSTNAME=""   # live hostname, e.g. portal.example.com
LEAKCHECK_ORIGIN_SSH_KEY=""    # SSH key filename
