{
    "name": "antonizick/nxcms",
    "description": "Self-hostable personal portal and portfolio CMS",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.3",
        "robthree/twofactorauth": "^3.0",
        "bacon/bacon-qr-code": "^3.0",
        "league/commonmark": "^2.4",
        "altcha-org/altcha": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
