# Docker Compose bootstrap values. Copy this file to .env and fill in real
# secrets — `make up` does this for you automatically with generated
# passwords if .env does not exist yet.
#
# These same DB_* names are what the installer (public/install.php) asks for
# on its "database" step. Use host "db" and port "3306" there — that's the
# name of the MySQL service below, not 127.0.0.1.

# Host ports (change if 8117/8118 are already taken on your machine)
WEB_PORT=8117
DB_PORT=8118

DB_DATABASE=portal
DB_USERNAME=portal
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too

# Optional. Set only if the admin panel is reverse-proxied on a separate
# origin from the public site (e.g. https://portal.example.com while the
# public site is example.com). Leave unset for a standard same-origin
# install — the admin panel then stays at /admin on the public domain.
# ADMIN_URL=https://portal.example.com
